NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Somente no servidor (Vercel > Environment Variables). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Google OAuth (mesmos do Supabase) e Google Picker (chave de API + número do projeto)
NEXT_PUBLIC_GOOGLE_API_KEY=AIza...
NEXT_PUBLIC_GOOGLE_APP_ID=607129469936
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Avisos push (PWA). Gere o par de chaves com:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu@email.com
